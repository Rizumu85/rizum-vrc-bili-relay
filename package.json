{
  "name": "vrc-bili-relay",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tools/dev.ts",
    "generate:assets": "bun run tools/generate-danmaku-backdrop.ts",
    "generate:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generate-app-icon.ps1",
    "build": "bun run tools/build.ts",
    "package:windows": "bun run tools/package-windows.ts",
    "build:worker": "cargo build --release --bin relay-worker",
    "build:ui": "bun run tools/build-ui.ts",
    "typecheck": "tsc --noEmit",
    "bench": "bun run benchmarks/render.bench.tsx"
  },
  "dependencies": {
    "@gpuix/native": "file:vendor/gpuix-native",
    "@gpuix/react": "file:vendor/gpuix-react",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
