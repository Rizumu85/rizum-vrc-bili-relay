{
  "name": "vrc-bili-relay-gpuix-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tools/dev.ts",
    "build": "bun run tools/build.ts",
    "build:worker": "cargo build --release --bin relay-worker",
    "build:ui": "bun build --compile src/main.tsx --outfile dist/vrc-bili-relay-gpuix.exe",
    "typecheck": "tsc --noEmit",
    "bench": "bun run benchmarks/render.bench.tsx"
  },
  "dependencies": {
    "@gpuix/react": "0.5.1",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
